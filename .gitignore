# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Virtual environments and local Python selection
.venv/
venv/
env/
.python-version

# Packaging and generated metadata
build/
dist/
*.egg-info/
.eggs/
*.egg
wheels/

# Coverage and test reports
.coverage
.coverage.*
coverage.xml
htmlcov/
*.log

# Local environment files. Keep documented examples.
.env
.env.*
!.env.informix.example
!.env.official-suites.example

# Informix certification output
/artifacts/*
!/artifacts/.gitkeep

# Editors and operating-system files
.vscode/
.vs/
.idea/
*.swp
*.swo
*.orig
.DS_Store
Thumbs.db

# Temporary files
/tmp/
*.tmp
