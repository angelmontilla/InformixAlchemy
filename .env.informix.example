# IBM Informix Docker image
IFX_IMAGE=icr.io/informix/informix-developer-database:15.0.0.0
IFX_LICENSE=accept
IFX_CONTAINER_NAME=informix
IFX_HOSTNAME=informix
IFX_TYPE=oltp
IFX_SIZE=small
IFX_SHM_SIZE=1gb

# Exposed ports on the host
IFX_PORT=9088
IFX_DRDA_PORT=9089
IFX_MONGO_PORT=27017
IFX_REST_PORT=27018
IFX_MQTT_PORT=27883

# Test database used by the local package tests and SQLAlchemy suite
IFX_DB=ifxalchemy_test

# Default credentials shipped by the official developer image
IFX_USER=informix
IFX_PASSWORD=in4mix

# ODBC / SQLAlchemy connection settings used by this fork
IFX_ODBC_DRIVER=IBM INFORMIX ODBC DRIVER (64-bit)
IFX_SERVER=informix
IFX_PROTOCOL=onsoctcp
IFX_HOST=127.0.0.1


# Server-only database creation through DB-Access in the Docker container.
IFXALCHEMY_DOCKER_EXECUTABLE=docker
IFXALCHEMY_DOCKER_CONTAINER=ifx
IFXALCHEMY_DOCKER_USER=informix
# Empty means: discover the absolute path under /opt without a shell.
# Set an absolute path only when automatic discovery is unavailable.
IFXALCHEMY_DOCKER_DBACCESS=
# docker exec does not load the informix login profile. These values are
# passed explicitly to DB-Access so GLS can load its locale categories.
IFXALCHEMY_DOCKER_INFORMIXDIR=/opt/ibm/informix
IFXALCHEMY_DOCKER_INFORMIXSERVER=informix
IFXALCHEMY_DOCKER_CLIENT_LOCALE=en_US.819
IFXALCHEMY_DOCKER_DB_LOCALE=en_US.819
IFXALCHEMY_DOCKER_SERVER_LOCALE=en_US.819
IFXALCHEMY_DOCKER_TIMEOUT=120

# Host-run tests (Python + pyodbc on the host machine)
INFORMIX_SQLALCHEMY_URL=informix+pyodbc://informix:in4mix@127.0.0.1/ifxalchemy_test?driver=IBM+INFORMIX+ODBC+DRIVER+(64-bit)&protocol=onsoctcp&server=informix&service=9088&DELIMIDENT=Y

# Explicit profile URLs. Missing databases are created automatically.
INFORMIX_SQLALCHEMY_NON_ANSI_URL=informix+pyodbc://informix:in4mix@127.0.0.1/ifxalchemy_test?DELIMIDENT=Y&driver=IBM+INFORMIX+ODBC+DRIVER+%2864-bit%29&protocol=onsoctcp&server=informix&service=9088
INFORMIX_SQLALCHEMY_ANSI_URL=informix+pyodbc://informix:in4mix@127.0.0.1/ifxalchemy_test_ansi?DELIMIDENT=Y&driver=IBM+INFORMIX+ODBC+DRIVER+%2864-bit%29&protocol=onsoctcp&server=informix&service=9088
