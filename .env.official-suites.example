# Two isolated Docker databases are required.
# Normal project/integration tests use the transactional non-ANSI database.
IFXALCHEMY_NON_ANSI_DATABASE=ifxalchemy_test
INFORMIX_SQLALCHEMY_NON_ANSI_URL=informix+pyodbc://informix:change-me@127.0.0.1/ifxalchemy_test?DELIMIDENT=Y&driver=IBM+INFORMIX+ODBC+DRIVER+%2864-bit%29&protocol=onsoctcp&server=informix&service=9088

# Official SQLAlchemy/Alembic suites use the ANSI database so owner/schema
# requirements are enabled.
IFXALCHEMY_ANSI_DATABASE=ifxalchemy_test_ansi
INFORMIX_SQLALCHEMY_ANSI_URL=informix+pyodbc://informix:change-me@127.0.0.1/ifxalchemy_test_ansi?DELIMIDENT=Y&driver=IBM+INFORMIX+ODBC+DRIVER+%2864-bit%29&protocol=onsoctcp&server=informix&service=9088

# Missing databases are created idempotently through sysmaster:
#   CREATE DATABASE ifxalchemy_test WITH LOG
#   CREATE DATABASE ifxalchemy_test_ansi WITH LOG MODE ANSI
IFXALCHEMY_CREATE_TEST_DATABASES_IF_MISSING=true
IFXALCHEMY_ADMIN_DATABASE=sysmaster


# Server-only database creation through DB-Access in the Docker container.
IFXALCHEMY_DOCKER_EXECUTABLE=docker
IFXALCHEMY_DOCKER_CONTAINER=ifx
IFXALCHEMY_DOCKER_USER=informix
# Empty means: discover the absolute path under /opt without a shell.
# Set an absolute path only when automatic discovery is unavailable.
IFXALCHEMY_DOCKER_DBACCESS=
# docker exec does not load the informix login profile. These values are
# passed explicitly to DB-Access so GLS can load its locale categories.
IFXALCHEMY_DOCKER_INFORMIXDIR=/opt/ibm/informix
IFXALCHEMY_DOCKER_INFORMIXSERVER=informix
IFXALCHEMY_DOCKER_CLIENT_LOCALE=en_US.819
IFXALCHEMY_DOCKER_DB_LOCALE=en_US.819
IFXALCHEMY_DOCKER_SERVER_LOCALE=en_US.819
IFXALCHEMY_DOCKER_TIMEOUT=120

# Optional dbspaces. Leave empty to let Informix choose.
IFXALCHEMY_NON_ANSI_DATABASE_DBSPACE=
IFXALCHEMY_ANSI_DATABASE_DBSPACE=

# The official suites remove/create objects in the ANSI database.
ALLOW_OFFICIAL_SUITE_DESTRUCTIVE_TESTS=true
OFFICIAL_SUITE_REQUIRE_EMPTY=true

# These databases must never receive destructive official-suite cleanup.
FORBIDDEN_DATABASE_NAMES=faempre,faempre_dev,prueba4db,sysmaster,sysadmin,sysutils,sysuser

IFXALCHEMY_INCLUDE_OUTPARAMS=0
SQLALCHEMY_SUITE_JUNIT=artifacts/sqlalchemy-suite.xml
ALEMBIC_SUITE_JUNIT=artifacts/alembic-suite.xml
